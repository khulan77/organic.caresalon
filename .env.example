# ─────────────────────────── Өгөгдлийн сан (Neon) ───────────────────────────
# Neon Console → Project → Connect дээрээс хоёр мөрийг хуулж авна.

# Pooled холболт (хаягт нь `-pooler` гэж байгаа). Апп ажиллуулахад хэрэглэнэ.
DATABASE_URL="postgresql://хэрэглэгч:нууцүг@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Шууд холболт (pooler-гүй). ЗӨВХӨН migration болон seed ажиллуулахад.
DIRECT_URL="postgresql://хэрэглэгч:нууцүг@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Заавал биш — `prisma migrate dev` дуудахад Prisma өөрөө түр сан үүсгэдэг.
SHADOW_DATABASE_URL=""

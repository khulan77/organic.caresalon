# Локал хөгжүүлэлтийн Prisma Postgres (`bun run db:dev` командаар асаана).
# АНХААР: prisma dev дахин асаахад порт өөрчлөгдвөл энэ хоёр мөрийг шинэчил.
DATABASE_URL="postgresql://хэрэглэгч:нууцүг@хост:5432/өгөгдлийнсан"
SHADOW_DATABASE_URL=""

# Сесс cookie-г гарын үсэглэх нууц түлхүүр (production дээр солино)
SESSION_SECRET="санамсаргүй-урт-тэмдэгт-мөр"

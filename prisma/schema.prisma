// Organic Care Nails & Spa — салон удирдлагын систем
// Цагийн дүрэм: DateTime талбарууд БҮГД UTC-д хадгалагдана.
//               Ажлын цаг (openMin/startMin гэх мэт) нь салоны ЛОКАЛ цагийн
//               шөнө дундаас хойшх минут (Asia/Ulaanbaatar, UTC+8).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────── Тоглогдох утгууд ───────────────────────────

/// Системд нэвтрэх хэрэглэгчийн эрх
enum Role {
  ADMIN // Админ — бүх эрхтэй
  RECEPTION // Ресепшн — бүх салбарын захиалга харна, тохиргоо өөрчлөхгүй
}

/// Төлбөрийн хэлбэр
enum PaymentMethod {
  CASH // Бэлэн
  CARD // Карт
  TRANSFER // Данс / QR
  OTHER // Бусад
}

/// Цаг захиалгын төлөв
enum AppointmentStatus {
  BOOKED // Захиалсан
  CONFIRMED // Баталгаажсан
  ARRIVED // Ирсэн
  COMPLETED // Дууссан
  CANCELLED // Цуцалсан
  NO_SHOW // Ирээгүй
}

// ─────────────────────────────── Салбар ────────────────────────────────

/// Салбар (Olympic, River Plaza, Эрдэнэт)
model Branch {
  id        String   @id @default(cuid())
  name      String   @unique // "Olympic Residence"
  address   String // "Олимпийн ордон, 2 давхар"
  phone     String?
  /// Ажлын эхлэх цаг — локал минут (600 = 10:00)
  openMin   Int      @default(600)
  /// Ажлын дуусах цаг — локал минут (1140 = 19:00)
  closeMin  Int      @default(1140)
  /// Хуанлийн нүдний алхам, минутаар
  slotMin   Int      @default(30)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff        Staff[]
  users        User[]
  appointments Appointment[]
  closures     BranchClosure[]
  services     Service[]

  @@map("branches")
}

/// Салбарын амралтын / онцгой ажлын өдөр
model BranchClosure {
  id       String   @id @default(cuid())
  branchId String
  /// Аль өдөр (зөвхөн огноо, локал хуанлийн өдөр)
  date     DateTime @db.Date
  /// Хаалттай эсэх. false бол тухайн өдрийн онцгой ажлын цаг гэсэн үг.
  isClosed Boolean  @default(true)
  openMin  Int?
  closeMin Int?
  reason   String? // "Шинэ жил", "Цагаан сар"

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, date])
  @@map("branch_closures")
}

// ──────────────────────────── Хэрэглэгч ────────────────────────────────

/// Системд нэвтрэх хэрэглэгч (админ, ресепшн)
model User {
  id                 String    @id @default(cuid())
  name               String
  /// Нэвтрэх нэр — утасны дугаараар нэвтэрнэ
  phone              String    @unique
  passwordHash       String
  role               Role      @default(RECEPTION)
  /// Үндсэн салбар. Ресепшн бүх салбарыг харна, энэ нь зөвхөн анхны сонголт.
  branchId           String?
  isActive           Boolean   @default(true)
  /// Түр нууц үгтэй эсэх. true бол анх нэвтрэхэд заавал өөрийн нууц үгээр солино.
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  branch         Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sessions       Session[]
  createdAppts   Appointment[]       @relation("AppointmentCreatedBy")
  cancelledAppts Appointment[]       @relation("AppointmentCancelledBy")
  createdCharges AppointmentCharge[] @relation("ChargeCreatedBy")
  receivedPays   Payment[]           @relation("PaymentReceivedBy")

  @@map("users")
}

/// Нэвтрэлтийн сесс (cookie дэх токены хэш)
model Session {
  id        String   @id @default(cuid())
  /// Cookie-д өгсөн токены SHA-256 хэш
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Амжилтгүй нэвтрэх оролдлого — brute force халдлагаас хамгаалахад ашиглана.
/// Амжилттай нэвтэрсэн эсвэл цонх дуусмагц мөрүүд устгагдана.
model LoginAttempt {
  id        String   @id @default(cuid())
  /// Хязгаарлалтын түлхүүр: "phone:99104657" эсвэл "ip:203.0.113.7"
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@map("login_attempts")
}

// ───────────────────────────── Ажилтан ─────────────────────────────────

/// Ажилтан (маникюрист, мастер) — хуанлийн багана бүр нэг ажилтан
model Staff {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  position  String? // "Маникюрист", "Мастер"
  branchId  String
  /// Хуанли дээрх өнгө (hex)
  color     String   @default("#94a3b8")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch       Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  schedules    StaffSchedule[]
  timeOffs     StaffTimeOff[]
  appointments Appointment[]

  @@index([branchId])
  @@map("staff")
}

/// Ажилтны долоо хоног давтагдах үндсэн хуваарь
model StaffSchedule {
  id       String  @id @default(cuid())
  staffId  String
  /// 0 = Ням, 1 = Даваа … 6 = Бямба
  weekday  Int
  /// Амралтын өдөр эсэх. true бол startMin/endMin хэрэглэгдэхгүй.
  isDayOff Boolean @default(false)
  startMin Int     @default(600)
  endMin   Int     @default(1140)

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, weekday])
  @@map("staff_schedules")
}

/// Тодорхой өдрийн чөлөө / амралт (үндсэн хуваарийг дарна)
model StaffTimeOff {
  id       String   @id @default(cuid())
  staffId  String
  date     DateTime @db.Date
  /// null бол бүтэн өдөр чөлөөтэй
  startMin Int?
  endMin   Int?
  reason   String? // "Чөлөө", "Өвчтэй", "Амралт"

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, date])
  @@map("staff_time_offs")
}

// ──────────────────────────── Үйлчилгээ ────────────────────────────────

/// Үйлчилгээний ангилал (Маникюр, Педикюр, Сормуус, Вакс, Спа)
model ServiceCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  color     String    @default("#a3a3a3")
  sortOrder Int       @default(0)
  services  Service[]

  @@map("service_categories")
}

/// Үйлчилгээ + үнэ
model Service {
  id          String    @id @default(cuid())
  categoryId  String
  /// Аль салбарын үйлчилгээ. Хоосон бол БҮХ салбарт нийтлэг.
  branchId    String?
  name        String
  /// Үргэлжлэх хугацаа, минутаар
  durationMin Int
  /// Үнэ, төгрөгөөр
  price       Int
  /// Хямдралтай үнэ. Тавьсан ба хүчинтэй бол энэ үнээр бодогдоно.
  salePrice   Int?
  /// Хямдрал дуусах агшин (UTC). Хоосон бол хугацаагүй.
  saleEndsAt  DateTime?
  /// Хуанли дээрх өнгө (hex). Хоосон бол ангиллын өнгийг авна.
  color       String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)

  category ServiceCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  branch   Branch?              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  items    AppointmentService[]

  // Нэг салбарын нэг ангилалд ижил нэр давхардахгүй.
  // (branchId = null нь бүх салбарт нийтлэг үйлчилгээ.)
  @@unique([categoryId, branchId, name])
  @@index([categoryId])
  @@index([branchId])
  @@map("services")
}

// ─────────────────────────── Үйлчлүүлэгч ───────────────────────────────

/// Үйлчлүүлэгч — нэр, утас, тэмдэглэл
model Client {
  id        String   @id @default(cuid())
  name      String
  /// Утасны дугаар — давхардахгүй, хайлтын түлхүүр
  phone     String   @unique
  /// Тэмдэглэл: хавчил, харшил, дуртай өнгө гэх мэт
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]

  @@index([name])
  @@map("clients")
}

// ────────────────────────── Цаг захиалга ───────────────────────────────

/// Цаг захиалга. startAt / endAt нь UTC.
model Appointment {
  id            String            @id @default(cuid())
  branchId      String
  staffId       String
  clientId      String
  /// Эхлэх цаг (UTC)
  startAt       DateTime
  /// Дуусах цаг (UTC) — үйлчилгээнүүдийн нийт хугацаагаар тооцно
  endAt         DateTime
  status        AppointmentStatus @default(BOOKED)
  note          String?
  /// Хамтарсан захиалгын бүлэг — нэг үйлчлүүлэгч ОЛОН ажилтанд ЗЭРЭГ үйлчлүүлэх.
  /// Бүлгийн бүх мөр ижил groupId, ЯГ ижил startAt/endAt-тай (зэрэг эхэлж
  /// зэрэг дуусна). null бол ганц ажилтны энгийн захиалга.
  groupId       String?
  /// Бүлгийн ҮНДСЭН мөр эсэх.
  /// Нэмэлт төлбөр ба төлбөрийн бичилт ЗӨВХӨН үндсэн мөрөнд наалдана —
  /// нэг үйлчлүүлэгч НЭГ нэхэмжлэх авна. Хөнгөлөлтийг мөр бүрийн үйлчилгээний
  /// дүнгээр хувь тэнцүүлэн хуваарилдаг тул ажилтны орлого зөв гарна.
  isPrimary     Boolean           @default(true)
  /// Үйлчилгээнүүдийн нийлбэр
  subtotal      Int               @default(0)
  /// Нэмэлт төлбөрүүдийн нийлбэр (charges). Тооцоог хурдан гаргахад хадгална.
  extraTotal    Int               @default(0)
  /// ХУУЧИН талбар — багц ба гараар өгдөг хөнгөлөлт байхгүй болсон.
  /// Түүхэн захиалгын дүн зөв харагдахын тулд үлдээв, шинэ захиалгад үргэлж 0.
  discount      Int               @default(0)
  /// ХУУЧИН талбар — дээрхтэй адил зөвхөн түүхэнд
  discountNote  String?
  /// Эцсийн төлөх дүн = subtotal + extraTotal − discount
  totalPrice    Int               @default(0)
  createdById   String?
  /// Цуцалсан / ирээгүй болгосон агшин (UTC). Идэвхтэй төлөвт буцаавал арилна.
  cancelledAt   DateTime?
  /// Хэн цуцалсан
  cancelledById String?
  /// Яагаад цуцалсан
  cancelReason  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  branch      Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  staff       Staff                @relation(fields: [staffId], references: [id], onDelete: Restrict)
  client      Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy   User?                @relation("AppointmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  cancelledBy User?                @relation("AppointmentCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  items       AppointmentService[]
  charges     AppointmentCharge[]
  payments    Payment[]

  // Хуанли татах гол индекс: салбар + өдрийн муж
  @@index([branchId, startAt])
  // Бүлгийн гишүүдийг цуглуулах
  @@index([groupId])
  // Давхцал шалгах индекс: ажилтан + цагийн муж
  @@index([staffId, startAt, endAt])
  @@index([clientId])
  @@map("appointments")
}

/// Нэг захиалганд орсон үйлчилгээ (олон үйлчилгээ авч болно).
/// Үнэ/хугацааг захиалгын үед хуулж авна — дараа үнэ өөрчлөгдвөл түүх алдагдахгүй.
model AppointmentService {
  id            String @id @default(cuid())
  appointmentId String
  serviceId     String
  /// Захиалгын үеийн нэр (үйлчилгээ уствал ч түүх үлдэнэ)
  name          String
  price         Int
  durationMin   Int
  sortOrder     Int    @default(0)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([appointmentId])
  @@map("appointment_services")
}

/// Захиалганд гараар нэмсэн НЭМЭЛТ ТӨЛБӨР — үйлчилгээний жагсаалтад байхгүй зардал.
/// Жишээ: урт хумс, нэмэлт чимэглэл, материалын нэмэгдэл.
/// Хугацаанд нөлөөлөхгүй — зөвхөн төлөх дүнг нэмнэ.
model AppointmentCharge {
  id            String   @id @default(cuid())
  appointmentId String
  /// Юуны төлбөр болох тайлбар
  label         String
  /// Дүн, төгрөгөөр. Эерэг байна.
  amount        Int
  createdById   String?
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  createdBy   User?       @relation("ChargeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([appointmentId])
  @@map("appointment_charges")
}

/// Захиалгын төлбөрийн бичилт. Урьдчилгаа, үлдэгдэл, буцаалт БҮГД энд мөр болно.
///
/// Нэг захиалга олон мөртэй байж болно:
///   урьдчилгаа 20,000₮ (isDeposit) → үлдэгдэл 30,000₮
/// Төлсөн нийт дүн = мөрүүдийн нийлбэр. Буцаалтыг СӨРӨГ дүнгээр бичнэ.
model Payment {
  id            String        @id @default(cuid())
  appointmentId String
  /// Төлсөн дүн, төгрөгөөр. Буцаалт бол сөрөг.
  amount        Int
  method        PaymentMethod @default(CASH)
  /// Урьдчилгаа эсэх — үйлчилгээ дуусахаас өмнө урьдчилж авсан төлбөр
  isDeposit     Boolean       @default(false)
  note          String?
  /// Төлбөрийг хүлээж авсан хэрэглэгч
  receivedById  String?
  createdAt     DateTime      @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  receivedBy  User?       @relation("PaymentReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)

  @@index([appointmentId])
  // Тайланд хугацаагаар шүүхэд
  @@index([createdAt])
  @@map("payments")
}
